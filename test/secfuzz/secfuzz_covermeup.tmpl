//go:build fuzz
// +build fuzz

package secfuzz

import "gvisor.dev/gvisor/pkg/bpf"

// Go's fuzzer discovers interesting inputs by tracking Go code coverage. It
// cannot see which BPF instructions were executed. Give each possible
// instruction a distinct Go branch so that reaching a new BPF instruction
// also gives the fuzzer new Go code coverage. BPF programs are limited to
// bpf.MaxInstructions, so we can enumerate every instruction here.
//
// Generate these branches separately for the two programs we compare.
// Reaching an instruction in one program must not count as covering that
// instruction in the other.
{{define "body"}}	covered := execution.Coverage
	switch len(covered) {
{{range .}}	case {{.Length}}:
		if covered[{{.Index}}] {
			fuzzee.coverage[{{.Index}}].Store(true)
		}
{{if .Index}}		fallthrough
{{end}}{{end}}	}
{{- end}}
// countExecutedLinesProgram1 converts coverage data of the first BPF program
// to Go coverage data.
func countExecutedLinesProgram1(execution bpf.ExecutionMetrics, fuzzee *Fuzzee) {
{{template "body" .}}
}

