{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "bots": {
      "description": "The trusted bots.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "github": {
            "description": "GitHub username.",
            "type": "string",
            "minLength": 1
          },
          "github_id": {
            "description": "GitHub user ID.",
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "github",
          "github_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bots"
  ],
  "additionalProperties": false
}
