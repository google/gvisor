load("//tools:defs.bzl", "go_library")

package(
    default_applicable_licenses = ["//:license"],
    licenses = ["notice"],
)

# The page size selected by --define pagesize, materialized as a Go constant so
# that it can be compared against hostarch.PageSize (which is selected
# independently by --go_tag=pagesize_64k).
genrule(
    name = "pagesize_define",
    outs = ["pagesize_define.go"],
    cmd = select({
        "//tools/bazeldefs:pagesize_64k": (
            "printf '%s\\n' " +
            "'// Generated by :pagesize_define. DO NOT EDIT.' " +
            "'' " +
            "'package pagesizecheck' " +
            "'' " +
            "'const definedPageSize = 65536' > $@"
        ),
        "//conditions:default": (
            "printf '%s\\n' " +
            "'// Generated by :pagesize_define. DO NOT EDIT.' " +
            "'' " +
            "'package pagesizecheck' " +
            "'' " +
            "'const definedPageSize = 4096' > $@"
        ),
    }),
)

# This library must stay a leaf: it may only be linked into final binaries.
# Depending on it from a library that is reachable through an arch_genrule
# transition would break the build, because those transitions reset
# //tools/build_defs/go:go_tag while leaving --define in place.
go_library(
    name = "pagesizecheck",
    srcs = [
        "pagesizecheck.go",
        ":pagesize_define.go",
    ],
    visibility = ["//:sandbox"],
    deps = ["//pkg/hostarch"],
)
