The NVIDIA parser only inspects drivers for AArch64 and X86. The llvm
0.8.26 module also requests seven backends used by its own tests. Its
extension combines target requests, so gVisor cannot remove those
backends from its own MODULE.bazel.

Remove this backport when the llvm module includes the development-only
backend configuration from https://github.com/hermeticbuild/hermetic-llvm/commit/17f6a3008.

diff --git a/MODULE.bazel b/MODULE.bazel
index 23b2b2ee..fa4d9229 100644
--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -40,19 +40,10 @@ LLVM_VERSION = "23.1.2"
 
 llvm = use_extension("//extensions:llvm.bzl", "llvm")
 llvm.version(llvm_version = LLVM_VERSION)
-llvm.configure(
-    targets = [
-        "AArch64",
-        "AMDGPU",
-        "ARM",
-        "BPF",
-        "NVPTX",
-        "RISCV",
-        "SystemZ",
-        "WebAssembly",
-        "X86",
-    ],
-)
+llvm.configure(targets = [
+    "AArch64",
+    "X86",
+])
 use_repo(llvm, "llvm-project", "llvm_version")
 
 llvm_toolchain_minimal = use_extension("//extensions:llvm_toolchain_minimal.bzl", "llvm_toolchain_minimal")
@@ -164,6 +155,19 @@ use_repo(kernel_headers, "kernel_headers")
 
 ######################### DEV DEPENDENCIES ###################################
 
+# Exercise these backends here without building them into every
+# downstream tool that links against LLVM.
+llvm_dev = use_extension("//extensions:llvm.bzl", "llvm", dev_dependency = True)
+llvm_dev.configure(targets = [
+    "AMDGPU",
+    "ARM",
+    "BPF",
+    "NVPTX",
+    "RISCV",
+    "SystemZ",
+    "WebAssembly",
+])
+
 bazel_dep(name = "gazelle", version = "0.47.0", dev_dependency = True)
 bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
 bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)
