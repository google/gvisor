package test1

// Each spelling checks both compiled evidence and an uninstantiated generic.

// +checkescape:all
//
//go:noinline
//go:nosplit{SPACE}
func nosplitSpace() {
	internalFunc()
}

// +checkescape:all
//
//go:noinline
//go:nosplit{SPACE}
func genericNosplitSpace[T any](v T) T {
	internalFunc()
	return v
}

// +checkescape:all
//
//go:noinline
//go:nosplit a compiler-accepted suffix
func nosplitSuffix() {
	internalFunc()
}

// +checkescape:all
//
//go:noinline
//go:nosplit a compiler-accepted suffix
func genericNosplitSuffix[T any](v T) T {
	internalFunc()
	return v
}

