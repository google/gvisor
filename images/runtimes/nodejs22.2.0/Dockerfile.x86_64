FROM ubuntu:jammy
RUN apt-get update && apt-get install -y \
  curl \
  dumb-init \
  g++ \
  make \
  patch \
  python3.10

WORKDIR /root
ARG VERSION=v22.2.0
RUN curl -o node-${VERSION}.tar.gz https://nodejs.org/dist/${VERSION}/node-${VERSION}.tar.gz \
 && tar -zxf node-${VERSION}.tar.gz \
 && rm -f node-${VERSION}.tar.gz

# Patch in a timeout increase to reduce test flakiness on gVisor
WORKDIR /root/node-${VERSION}
COPY timeouts.patch /tmp/timeouts.patch
RUN patch -p1 --no-backup-if-mismatch < /tmp/timeouts.patch \
  && rm -f /tmp/timeouts.patch

RUN ./configure
RUN make -j $(nproc) test-build

# Use node --check on the files we patched
RUN out/Release/node --check test/common/index.js \
  && out/Release/node --check test/parallel/test-http-outgoing-end-cork.js

# Select the certificate for www.nodejs.org in the CA interaction test.
COPY tls-servername.patch /tmp/tls-servername.patch
RUN patch -p1 --no-backup-if-mismatch < /tmp/tls-servername.patch \
  && out/Release/node --check test/internet/test-tls-add-ca-cert.js \
  && rm -f /tmp/tls-servername.patch

# Including dumb-init emulates the Linux "init" process, preventing the failure
# of tests involving worker processes.
ENTRYPOINT ["/usr/bin/dumb-init"]
